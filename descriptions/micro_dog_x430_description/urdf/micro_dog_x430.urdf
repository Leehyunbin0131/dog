  </link>
  <joint name="FL_roll_joint" type="revolute">
    <parent link="base_link" />
    <child link="FL_hip" />
    <origin xyz="0.095 0.029 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-0.6" upper="0.6" effort="1.0" velocity="2.0" />
    <dynamics damping="0.02" friction="0" />
  </joint>
  <joint name="FL_pitch_joint" type="revolute">
    <parent link="FL_hip" />
    <child link="FL_thigh" />
    <origin xyz="0.03875 0.0144 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.2" upper="1.2" effort="0.5" velocity="2.0" />
    <dynamics damping="0.02" friction="0" />
  </joint>
  <joint name="FL_knee_joint" type="revolute">
    <parent link="FL_thigh" />
    <child link="FL_shank" />
    <origin xyz="-0.1425 0.0381625 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.4" upper="1.4" effort="0.5" velocity="2.0" />
